# URL base del backend de Laravel (sin barra final).
#
#   Navegador en la misma maquina ....... http://localhost:8000
#   Emulador de Android ................. http://10.0.2.2:8000
#   Dispositivo fisico en la misma red .. http://192.168.X.X:8000
#
# En dispositivo fisico se usa la IP de la computadora que corre
# `php artisan serve --host=0.0.0.0`, no localhost.
VITE_API_URL=http://10.0.2.2:8000
